<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <SqlInterpolDialects>CustomDb</SqlInterpolDialects>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SqlInterpolDialects" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <DefineConstants>$(DefineConstants);CSHARP14_EXTENSION_TYPES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SqlInterpol\SqlInterpol.csproj" />
  </ItemGroup>

</Project>