<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    
    <IsTestProject>false</IsTestProject>
    <DiscoverTests>false</DiscoverTests>
    <ExcludeFromTestExplorer>true</ExcludeFromTestExplorer>
    
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TargetExt>.shared</TargetExt>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <DefineConstants>$(DefineConstants);CSHARP14_EXTENSION_TYPES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.core" Version="2.9.3" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="xunit.assert" Version="2.9.3" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SqlInterpol.Testing.Specifications\SqlInterpol.Testing.Specifications.csproj" />
    <ProjectReference Include="..\..\..\src\SqlInterpol.Testing.Xunit\SqlInterpol.Testing.Xunit.csproj" />
    <ProjectReference Include="..\SqlInterpol.Extensibility\SqlInterpol.Extensibility.csproj" />
  </ItemGroup>

</Project>