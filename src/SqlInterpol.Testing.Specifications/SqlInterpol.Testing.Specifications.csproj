<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Specifications\**\*.cs" Pack="true" PackagePath="Templates\Specifications" />
    <None Include="SqlInterpol.Testing.Specifications.props" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlInterpol.Generators\SqlInterpol.Generators.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false" />
    
    <ProjectReference Include="..\SqlInterpol.Testing.Xunit\SqlInterpol.Testing.Xunit.csproj" />
                      
    <None Include="..\SqlInterpol.Generators\bin\$(Configuration)\netstandard2.0\SqlInterpol.Generators.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs" 
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <LangVersion>preview</LangVersion>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);SqlInterpol.Generators.Generated</InterceptorsPreviewNamespaces>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Features>InterceptorsPreview</Features>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);SqlInterpol.Generators.Generated</InterceptorsNamespaces>
  </PropertyGroup>

</Project>